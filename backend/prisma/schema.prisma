// Skema database Populi WA Survey. Lihat docs/ARCHITECTURE.md §5.
generator client {
  provider      = "prisma-client-js"
  // native = dev (Windows/mac); linux-musl-openssl-3.0.x = runtime Docker Alpine (OpenSSL 3)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  admin
  viewer
}

enum SurveyStatus {
  draft
  active
  closed
}

enum BlastStatus {
  pending
  scheduled
  running
  completed
  failed
}

enum RecipientStatus {
  queued
  sent
  delivered
  read
  failed
}

enum Direction {
  in
  out
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?
  passwordHash String
  role         Role     @default(admin)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Survey {
  id              String       @id @default(cuid())
  title           String
  description     String?
  status          SurveyStatus @default(draft)
  triggerEnabled  Boolean      @default(false) // mulai survei otomatis bila pesan masuk cocok kata kunci
  // true = satu kontak hanya boleh MENYELESAIKAN survei ini sekali (pemicu berikutnya ditolak
  // halus). Penting untuk kualitas data riset. Default false = perilaku lama (boleh berulang).
  oncePerContact  Boolean      @default(false)
  triggerKeywords String[]     @default([]) // kata kunci pemicu (mis. "isi survey", "survei")
  mode            String       @default("chat") // chat (tanya-jawab per pesan) | flow (formulir WhatsApp Flow)
  flowId          String? // ID Flow terbit di Meta (mode flow)
  flowCta         String? // label tombol pembuka flow (mis. "Isi Survei")
  flowPerScreen   Int          @default(4) // mode flow: berapa pertanyaan per layar (multi-layar)
  privacyUrl      String? // tautan kebijakan privasi (EmbeddedLink di layar pertama flow)
  bannerUrl       String? // gambar banner di pesan pembuka survei (header pesan Flow / caption di mode chat)
  closingMessage  String? // kata penutup custom saat survei selesai (kosong = pakai default)
  // Batas jumlah responden SELESAI untuk seluruh survei. null = tanpa batas.
  // Begitu tercapai, survei berhenti menerima responden baru — pemicu ditolak halus dan
  // blast melewati sisa penerimanya. Ini pengendali biaya: tiap responden berbiaya pesan.
  targetResponden Int?
  // Pertanyaan yang jawabannya dipakai sebagai PROVINSI responden, untuk kuota per provinsi.
  //
  // Perlu disimpan karena pertanyaan provinsi tidak selalu bertipe "wilayah": instrumen yang
  // sudah berjalan memakai tipe "choice" berisi nama provinsi, dan mengganti tipenya berarti
  // membangun ulang Flow di Meta. Tanpa penunjuk ini, mesin hanya mengenali tipe "wilayah"
  // sehingga responden baru tidak pernah distempel dan kuota provinsi tak pernah bertambah.
  //
  // Diisi otomatis oleh skrip backfill:provinsi, yang menilai tiap pertanyaan dari
  // jawabannya. Pertanyaan bertipe "wilayah" tidak membutuhkannya — ia selalu dikenali.
  questionProvinsiId String?
  createdAt       DateTime     @default(now())
  questions       Question[]
  blasts          Blast[]
  responses       SurveyResponse[]
  kuotaProvinsi   KuotaProvinsi[]
}

// Kuota responden per provinsi untuk satu survei.
//
// Dipakai saat klien membatasi sebaran, mis. Jawa Barat 200 responden dan Jawa Tengah 150.
// Tanpa ini, satu provinsi yang ramai bisa menghabiskan anggaran pesan sebelum provinsi
// lain terwakili — dan datanya pun jadi timpang.
model KuotaProvinsi {
  id           String @id @default(cuid())
  surveyId     String
  survey       Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  kodeProvinsi String // 2 digit, kode resmi Kepmendagri (lihat lib/wilayah.ts)
  target       Int

  @@unique([surveyId, kodeProvinsi])
  @@index([surveyId])
}

model Question {
  id       String  @id @default(cuid())
  surveyId String
  survey   Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  // text | rating | number | choice | multichoice | boolean | consent | date | image | wilayah
  // wilayah = provinsi + kabupaten/kota menurut kode resmi Kepmendagri (lihat lib/wilayah.ts).
  // Di Flow ia jadi dua dropdown bertingkat; di mode chat responden mengetik nama wilayahnya.
  type     String  @default("text")
  text     String
  order    Int     @default(0)
  required Boolean @default(true)
  options  Json? // konfig per tipe: rating {min,max}, choice {choices:[...]}
  answers  Answer[]
}

model Segment {
  id        String           @id @default(cuid())
  name      String
  createdAt DateTime         @default(now())
  contacts  SegmentContact[]
  blasts    Blast[]
}

model Contact {
  id            String           @id @default(cuid())
  phone         String           @unique // E.164, mis. 628xxxxxxxxx
  name          String?
  attributes    Json?
  subscribed    Boolean          @default(true) // false = opt-out (dikecualikan dari blast)
  optOutAt      DateTime? // kapan kontak menyatakan berhenti
  consentSource String? // sumber persetujuan: manual | import | inbound | form
  consentAt     DateTime?
  createdAt     DateTime         @default(now())
  segments      SegmentContact[]
  messages      Message[]
  recipients    BlastRecipient[]
  responses     SurveyResponse[]
}

model SegmentContact {
  segmentId String
  contactId String
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([segmentId, contactId])
}

model Blast {
  id             String           @id @default(cuid())
  surveyId       String?
  survey         Survey?          @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  segmentId      String?
  segment        Segment?         @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  vendor         String // "meta" | "qontak"
  templateName   String?
  templateLang   String           @default("id")
  messageText    String? // teks/preview pesan (untuk audit)
  status         BlastStatus      @default(pending)
  scheduledAt    DateTime?
  sentCount      Int              @default(0)
  deliveredCount Int              @default(0)
  readCount      Int              @default(0)
  failedCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  recipients     BlastRecipient[]
  responses      SurveyResponse[]
}

model BlastRecipient {
  id              String          @id @default(cuid())
  blastId         String
  blast           Blast           @relation(fields: [blastId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vendor          String
  vendorMessageId String?         @unique
  status          RecipientStatus @default(queued)
  error           String?
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())

  @@index([blastId])
  @@index([vendorMessageId])
}

model Message {
  id              String    @id @default(cuid())
  contactId       String?
  // Cascade, BUKAN SetNull. Dulu menghapus kontak hanya mengosongkan contactId: baris
  // pesannya tetap tinggal lengkap dengan `payload` berisi muatan webhook mentah — di
  // dalamnya ada nomor telepon dan isi percakapan. Jadi "hapus kontak" tidak pernah
  // benar-benar menghapus data orangnya, hanya memutus tautannya dari daftar kontak.
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction       Direction
  vendor          String
  vendorMessageId String?
  text            String?
  payload         Json?
  isBot           Boolean   @default(false) // true = balasan otomatis (survei/auto-reply/AI), bukan kiriman agen
  source          String? // asal balasan otomatis: survey | autoreply | ai | optout. null = kiriman agen
  // Status antar dari vendor (pesan KELUAR): sent | delivered | read | failed. null = belum ada kabar.
  // Vendor menerima pesan lalu melaporkan kegagalan antar BELAKANGAN lewat webhook status,
  // jadi respons API yang sukses sama sekali tidak menjamin pesannya sampai.
  deliveryStatus  String?
  failedReason    String? // alasan gagal apa adanya dari vendor; diisi hanya saat deliveryStatus = failed
  createdAt       DateTime  @default(now())

  @@index([contactId])
  @@index([vendorMessageId])
  @@index([contactId, source, createdAt]) // untuk menghitung kuota balasan AI per kontak
  @@index([deliveryStatus, createdAt]) // untuk panel "gagal diantar" di Dashboard
}

model SurveyResponse {
  id          String    @id @default(cuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  blastId     String?
  blast       Blast?    @relation(fields: [blastId], references: [id], onDelete: SetNull)
  currentStep Int       @default(0) // indeks pertanyaan berikutnya (untuk alur chat)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  // Sudah tertulis ke Google Sheets. Penjaga idempoten worker sheets sekaligus dasar
  // backfill (completedAt terisi + sheetSyncedAt kosong = belum terdorong).
  sheetSyncedAt DateTime?
  // Provinsi responden, 2 digit kode resmi. Distempel saat diketahui — dari atribut kontak
  // hasil impor bila ada, atau dari jawaban pertanyaan wilayah. Disimpan di sini, bukan
  // dihitung ulang dari jawaban, supaya penghitungan kuota cukup satu groupBy dan tidak
  // bergantung pada format nilai jawaban.
  kodeProvinsi  String?
  // true = responden menolak pada pertanyaan bertipe consent, sehingga surveinya berhenti
  // di situ. Responsnya tetap "selesai", tapi TIDAK mengandung data — karena itu tidak
  // dihitung ke kuota. Klien membayar untuk data, bukan untuk penolakan.
  //
  // Disimpan sebagai penanda, bukan dihitung ulang dari tabel Answer: pemeriksaan kuota
  // berjalan pada SETIAP pesan masuk dan SETIAP pengiriman blast, jadi harus murah.
  // Menelusuri jawaban tiap kali berarti subkueri ke 139 ribu baris jawaban per pemeriksaan.
  consentDitolak Boolean @default(false)
  answers       Answer[]

  @@index([contactId])
  @@index([surveyId, kodeProvinsi]) // untuk menghitung kuota per provinsi
  @@index([surveyId, consentDitolak]) // kuota global mengecualikan penolak consent
}

model Answer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  createdAt  DateTime       @default(now())
}

model VendorConfig {
  id          String   @id @default(cuid())
  vendor      String   @unique // "meta" | "qontak"
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  credentials String? // JSON terenkripsi (AES-256-GCM)
  updatedAt   DateTime @updatedAt
}

model AutoReplyRule {
  id        String   @id @default(cuid())
  name      String
  matchType String   @default("contains") // contains | exact | starts
  keyword   String
  response  String
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([enabled])
}

model AiConfig {
  id           String   @id // singleton: "default"
  enabled      Boolean  @default(false)
  provider     String   @default("anthropic") // anthropic | openai | gemini | custom
  model        String   @default("claude-haiku-4-5-20251001")
  baseUrl      String? // untuk provider custom (OpenAI-compatible)
  systemPrompt String   @default("Anda asisten layanan pelanggan via WhatsApp. Jawab singkat, ramah, dan jelas dalam Bahasa Indonesia.")
  apiKey       String? // terenkripsi (AES-256-GCM)
  // Pembatas biaya & waktu. Balasan WhatsApp memang harus pendek, jadi batas ketat
  // di sini menghemat token tanpa mengurangi kegunaan.
  maxTokens        Int      @default(300) // panjang maksimal satu balasan AI
  historyLimit     Int      @default(6) // jumlah pesan terakhir yang dikirim sebagai konteks
  maxRepliesPerDay Int      @default(5) // kuota balasan AI per kontak per 24 jam; 0 = tanpa batas

  // Mati otomatis saat kuota seluruh survei terpenuhi. Tiap balasan AI adalah pesan
  // berbayar, dan setelah kuota penuh ia tidak lagi membawa responden baru.
  //
  // offOtomatisPada: kapan sistem yang mematikannya. Dipakai layar Agen AI untuk
  // menjelaskan sebabnya — tanpa itu operator akan mengira ada orang lain yang mematikan.
  // Dikosongkan begitu agennya aktif kembali dengan kuota yang sudah longgar.
  offOtomatisPada DateTime?
  // izinOffOtomatis: boleh tidak sistem mematikannya lagi. Disetel false begitu sistem
  // mematikan sekali, dan TIDAK dipulihkan saat operator menyalakan manual — itulah yang
  // membuat "nyalakan manual" benar-benar bertahan, bukan mati lagi pada pesan berikutnya.
  // Pulih sendiri hanya ketika kuota kembali longgar, siap untuk episode berikutnya.
  izinOffOtomatis Boolean @default(true)

  updatedAt        DateTime @updatedAt
}

// Integrasi Google Sheets: tiap respons survei selesai didorong worker jadi satu baris
// di spreadsheet tim (satu tab per survei) — tanpa ekspor manual. Lihat services/sheetPush.ts.
model SheetConfig {
  id            String  @id // singleton: "default"
  enabled       Boolean @default(false)
  spreadsheetId String?
  // Kunci service account Google (JSON utuh), terenkripsi AES-256-GCM.
  // Spreadsheet harus di-share ke client_email service account sebagai Editor.
  serviceAccountJson String?
  updatedAt          DateTime @updatedAt
}

model WebhookLog {
  id        String   @id @default(cuid())
  vendor    String
  event     String
  status    String // success | failed | ignored
  payload   Json?
  note      String?
  createdAt DateTime @default(now())

  @@index([vendor])
  @@index([createdAt])
}

// Template pesan WhatsApp (harus disetujui Meta sebelum dipakai broadcast).
// Disimpan lokal sebagai draf/arsip; status approval dikelola manual mengikuti Meta.
model MessageTemplate {
  id             String   @id @default(cuid())
  name           String // nama template (snake_case, sesuai Meta)
  category       String   @default("MARKETING") // MARKETING | UTILITY | AUTHENTICATION
  language       String   @default("id") // id | en_US | ...
  headerType     String   @default("none") // none | text | image | document | video
  headerText     String? // dipakai bila headerType = text
  headerMediaUrl String? // contoh URL media (gambar/dokumen/video) untuk preview & sampel approval
  bodyText       String // isi utama, boleh berisi variabel {{1}} {{2}}
  footerText     String?
  buttons        Json? // [{type:"QUICK_REPLY"|"URL"|"PHONE_NUMBER", text, url?, phone?}]
  sampleParams   String[] @default([]) // contoh nilai untuk {{1}}, {{2}} (untuk preview & submit ke Meta)
  status         String   @default("draft") // draft | submitted | approved | rejected (label LOKAL)
  useCase        String? // survei | rilis | acara | lainnya

  // ===== Cermin status ASLI di Meta (diisi oleh /api/templates/sync) =====
  // Sumber kebenaran untuk "boleh dipakai broadcast atau tidak". Dibedakan dari `status`
  // di atas yang hanya label lokal & bisa menyesatkan (mis. "approved" padahal belum diajukan).
  metaStatus     String? // APPROVED | PENDING | IN_REVIEW | REJECTED | PAUSED | DISABLED. null = TIDAK ada di Meta
  metaQuality    String? // GREEN | YELLOW | RED | UNKNOWN (quality rating Meta)
  metaCategory   String? // kategori menurut Meta (bisa berbeda — Meta kadang mengklasifikasi ulang)
  metaButtons    String[] @default([]) // TIPE tombol menurut Meta, urut indeks: QUICK_REPLY | URL | PHONE_NUMBER | FLOW
  metaBodyParams Int? // jumlah variabel {{n}} di BODY menurut Meta. Jumlah parameter saat kirim wajib sama persis.
  metaHeaderFormat String? // format header MENURUT META: text | image | document | video (null = tanpa header).
  // Sumber kebenaran saat blast: parameter header yang dikirim WAJIB cocok dengan ini,
  // kalau tidak Meta menolak (#132012 "Parameter format does not match format in the created template").
  metaId         String? // id template di Meta
  metaReason     String? // rejected_reason bila ditolak
  metaSyncedAt   DateTime? // kapan terakhir dicocokkan ke Meta. null = belum pernah disinkron

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Kebijakan pengiriman (anti-banned): batas harian + jitter antar pesan (warm-up).
model SendingPolicy {
  id          String   @id // singleton: "default"
  enabled     Boolean  @default(true)
  dailyLimit  Int      @default(500) // maks pesan keluar / hari (naikkan bertahap saat warm-up)
  jitterMinMs Int      @default(800) // jeda acak min antar pesan
  jitterMaxMs Int      @default(2500) // jeda acak maks antar pesan
  updatedAt   DateTime @updatedAt
}

// Daftar penekan opt-out: nomor yang pernah menyatakan BERHENTI.
//
// Sengaja berdiri sendiri, TIDAK berelasi ke Contact dan karena itu tidak ikut terhapus
// bersamanya. Dulu penolakan hanya tersimpan sebagai Contact.subscribed = false, sehingga
// menghapus kontaknya menghapus pula jejak penolakannya: nomor yang sama bisa diimpor
// ulang dari berkas lama lalu dihubungi lagi seolah tak pernah menolak. Menghapus kontak
// tidak boleh memulihkan izin menghubungi.
//
// Nomor di sini bukan "data yang kami simpan untuk dipakai", melainkan catatan minimum
// yang justru diperlukan untuk MENGHORMATI penolakan — tanpa menyimpan nomornya, tidak
// ada cara mengenali bahwa ia pernah menolak.
model OptOutNumber {
  phone     String   @id // E.164 tanpa +, hasil normalizePhone
  reason    String? // pesan berhenti | manual | impor
  createdAt DateTime @default(now())
}

// Kartu tarif WhatsApp — DIISI MANUAL, dan BERVERSI.
//
// Berversi, bukan satu baris yang ditimpa: kalau tarif cuma satu angka lalu diubah bulan
// depan, seluruh invoice lama ikut berubah nilainya — dan invoice yang sudah diajukan ke
// klien jadi tidak bisa dipertanggungjawabkan. Tiap set punya tanggal berlaku, dan
// perhitungan selalu memakai set yang berlaku pada tanggal pesannya dikirim.
//
// Diisi manual (bukan diambil dari API Meta) karena Meta mengubah tarif beberapa kali
// setahun dan formatnya tidak stabil; mengetik ulang empat angka jauh lebih murah daripada
// menebak-nebak dari sumber yang berubah.
model TarifWa {
  id             String   @id @default(cuid())
  berlakuSejak   DateTime // tarif ini dipakai untuk pesan yang dikirim pada/sesudah tanggal ini
  mataUang       String   @default("IDR")
  marketing      Float
  utility        Float
  authentication Float
  service        Float
  // Jatah pesan service gratis per NOMOR per BULAN kalender, tidak diakumulasi.
  // Bawaan 0 = SELURUH pesan service ditagih. Jatah ini milik bulan, bukan milik satu
  // survei; kalau dalam sebulan ada dua-tiga survei, membebankannya ke salah satu survei
  // bersifat sewenang-wenang. Isi angkanya hanya bila memang ingin dipotong.
  gratisServicePerBulan Int   @default(0)
  // pajakPersen = angka yang DITULIS di invoice. pajakEfektifPersen = angka yang benar-benar
  // DIKALIKAN. Keduanya berbeda di Indonesia: PPN 12% dikenakan atas dasar pengenaan pajak
  // 11/12 nilai, sehingga efektifnya 11% — persis seperti invoice Meta, yang menulis
  // "Tax (12%)" lalu menagih 11% dan menandainya dengan tanda bintang. Menyamakan keduanya
  // membuat invoice ke klien tidak cocok dengan invoice Meta yang direkonsiliasi.
  pajakPersen           Float @default(0)
  pajakEfektifPersen    Float? // null = sama dengan pajakPersen
  catatan               String?
  createdAt             DateTime @default(now())

  @@index([berlakuSejak])
}

// Profil penerbit invoice — pengaturan tunggal, seperti AiConfig/SheetConfig/SendingPolicy.
//
// Isinya bagian invoice yang TIDAK pernah berganti: alamat lembaga penerbit beserta NPWP,
// Account ID Meta, dan metode pembayaran. Sebelumnya semua itu harus diketik ulang di
// setiap invoice. Bukan sekadar merepotkan — satu digit NPWP yang salah ketik di invoice
// pajak adalah persoalan nyata, dan kesalahan seperti itu justru paling mungkin terjadi
// saat mengetik ulang hal yang sama berkali-kali.
//
// Yang berganti per klien (nama, alamat penagihan, Reference Number, Transaction ID)
// sengaja TIDAK disimpan di sini: menyimpannya akan membuat invoice klien berikutnya
// terisi data klien sebelumnya.
model ProfilInvoice {
  id        String   @id // singleton: "default"
  penerbit  String? // alamat penerbit, bebas baris, diakhiri NPWP
  accountId String?
  metode    String? // mis. "Visa ···· 3809"
  produk    String   @default("WhatsApp Business Account")
  status    String   @default("Paid")
  updatedAt DateTime @updatedAt
}
